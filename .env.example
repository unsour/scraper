# Один из двух ключей обязателен для шага 04_enrich.py
FIREWORKS_API_KEY=fw_...
OPENROUTER_API_KEY=sk-or-...

# Поисковые запросы для JobSpy (через запятую)
JOBS_SEARCH_TERMS=software engineer,data engineer,product manager

# Максимум компаний из Companies House (уменьши для теста)
MAX_COMPANIES=50000

# Размер батча для LLM
LLM_BATCH_SIZE=20

# Минимальный quality_score для экспорта
MIN_QUALITY_SCORE=60
